// Experiment 3: Conditions and Loops

let marks = 78;

if (marks >= 90) {
    console.log("Grade A");
}
else if (marks >= 75) {
    console.log("Grade B");
}
else if (marks >= 60) {
    console.log("Grade C");
}
else {
    console.log("Needs Improvement");
}

// For Loop
console.log("Numbers from 1 to 5:");

for (let i = 1; i <= 5; i++) {
    console.log(i);
}

// While Loop
let count = 3;

while (count >= 1) {
    console.log("Countdown:", count);
    count--;
}