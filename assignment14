// Experiment 14: Timers and Intervals

console.log("Program Started");

// Set Timeout
setTimeout(function() {
    console.log("This message appears after 2 seconds");
}, 2000);

// Set Interval
let count = 1;

let timer = setInterval(function() {

    console.log("Count:", count);

    count++;

    if (count > 5) {
        clearInterval(timer);
        console.log("Timer Stopped");
    }

}, 1000);